{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/manuals/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/manual-index/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/audio/tavern.mp3",
      "destination": "/audio/old-tower-inn.mp3"
    },
    {
      "source": "/audio/common-room.mp3",
      "destination": "/audio/bards-tale.mp3"
    },
    {
      "source": "/audio/dungeon.mp3",
      "destination": "/audio/cave-theme.mp3"
    },
    {
      "source": "/audio/battle.mp3",
      "destination": "/audio/battle-theme.mp3"
    },
    {
      "source": "/audio/arcane.mp3",
      "destination": "/audio/ancient-power-of-serpents.mp3"
    },
    {
      "source": "/audio/cards.mp3",
      "destination": "/audio/warm-fireplace.mp3"
    },
    {
      "source": "/audio/chess.mp3",
      "destination": "/audio/vaporware.mp3"
    },
    {
      "source": "/audio/challenge.mp3",
      "destination": "/audio/determined-pursuit.mp3"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/termini",
      "destination": "/index.html"
    },
    {
      "source": "/cookie",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/index.html"
    },
    {
      "source": "/segnala",
      "destination": "/index.html"
    },
    {
      "source": "/bottega/condizioni",
      "destination": "/index.html"
    },
    {
      "source": "/bottega",
      "destination": "/index.html"
    },
    {
      "source": "/bottega/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/minigames/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dnd/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/shop/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/library/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/magic/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/carte/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/giochi-di-ruolo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/oracolo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/gestione/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/multiplayer",
      "destination": "/index.html"
    },
    {
      "source": "/mtcg/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/mtcg",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.scryfall.com; media-src 'self' blob:; frame-src 'self' blob: https://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
