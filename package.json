{
  "name": "la-taverna-vtt",
  "private": true,
  "version": "1.1.0",
  "description": "Virtual Tabletop immersivo in stile Ametista & Void",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "test:cards": "node --test scripts/tests/*.test.mjs",
    "test:oracle": "node --test scripts/tests/oracle-markdown.test.mjs",
    "test:scippo": "node --test scripts/tests/scippo.test.mjs",
    "test:view": "node --test scripts/tests/scippo-view.test.mjs scripts/tests/minigames-view.test.mjs",
    "test:layout": "node scripts/test-magic-layout.mjs",
    "tunnel": "ngrok http 127.0.0.1:31415 --traffic-policy-file scripts/ngrok-policy.json --inspect=false --log stdout",
    "watch:gateway": "node --env-file-if-exists=.env.local scripts/gateway-watch.mjs",
    "prices:import": "node scripts/import-scryfall-prices.mjs",
    "lint": "echo \"Sguardo dell'Oste: Tutto in ordine!\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "chess.js": "^1.4.0",
    "howler": "^2.2.4",
    "motion": "^12.42.2",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "terser": "^5.31.0",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "vtt",
    "rpg",
    "supabase",
    "gaming",
    "tabletop"
  ],
  "author": "Il Viandante",
  "license": "MIT"
}
